{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        // Refresh RPM lockfiles in the same PR as Dockerfile base-image updates.
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "branchPrefix": "renovate/",
    // Only target main branch + branches that are **past code freeze**.
    //  If this targets a branch that is before code freeze, it will cause conflicts on main/release sync.
    "baseBranches": ["main", "rhoai-2.25", "rhoai-3.3", "rhoai-3.4", "rhoai-3.5", "rhoai-3.6"],
    "ignoreTests": true,
    "automergeType": "pr",
    "automerge": true,
    // No rate limit on PRs
    "prHourlyLimit": 0,
    "enabledManagers": ["dockerfile", "rpm", "rpm-lockfile", "custom.regex"],
    "customManagers": [
      {
        // Select FROM instructions first, then replace only the image token.
        // Track the 9.8 tag even when the existing reference has only a digest.
        "customType": "regex",
        "managerFilePatterns": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          "(?:^|\\r?\\n)[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?registry\\.redhat\\.io/ubi9/ubi-minimal-pqc(?::9\\.8)?@sha256:[a-f0-9]{64}",
          "(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)(?::9\\.8)?@(?<currentDigest>sha256:[a-f0-9]{64})"
        ],
        "currentValueTemplate": "9.8",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
      }
    ],
    "packageRules": [
      {
        // Auto-merge digest updates for Konflux Dockerfiles only
        "matchManagers": ["dockerfile"],
        "matchUpdateTypes": ["digest"],
        "matchFileNames": [
          // Existing patterns (keep): <component>.Dockerfile.konflux, Dockerfile.konflux, etc.
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          // Additional patterns: Dockerfile.<component>.konflux (e.g. feast)
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*"
        ],
        "enabled": true,
        "ignoreTests": true,
        "automergeType": "pr",
        "automerge": true,
        "groupName": "Dockerfile Digest Updates",
        "branchPrefix": "renovate/docker-main/",
        "semanticCommits": "enabled"
      },
      {
        "matchManagers": ["rpm"],
        "groupName": "RPM Updates",
        "commitMessageTopic": "RPM updates",
        "enabled": true,
        "schedule": ["at any time"],
        "branchPrefix": "renovate/rpm/",
        "semanticCommits": "enabled"
      },
      {
        // Enforce CI checks before automerge for AI Pipelines repos
        "matchRepositories": [
          "red-hat-data-services/data-science-pipelines",
          "red-hat-data-services/data-science-pipelines-operator",
          "red-hat-data-services/pipelines-components",
          "red-hat-data-services/argo-workflows"
        ],
        "ignoreTests": false,
        "platformAutomerge": false
      },
      {
        // Keep the custom PQC manager disabled except for the Praxis pilot below.
        "matchManagers": ["custom.regex"],
        "matchPackageNames": ["registry.redhat.io/ubi9/ubi-minimal-pqc"],
        "enabled": false
      },
      {
        "matchRepositories": ["red-hat-data-services/praxis-ai-grid-operator"],
        "matchBaseBranches": ["main", "rhoai-3.6"],
        "matchManagers": ["custom.regex"],
        "matchPackageNames": ["registry.redhat.io/ubi9/ubi-minimal-pqc"],
        "enabled": true,
        "allowedVersions": "/^9\\.8$/",
        "automerge": false,
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "branchTopic": "ubi-minimal-pqc-9.8"
      },
      {
        // Avoid competing Dockerfile updates only on the pilot branches/repo.
        "matchRepositories": ["red-hat-data-services/praxis-ai-grid-operator"],
        "matchBaseBranches": ["main", "rhoai-3.6"],
        "matchManagers": ["dockerfile"],
        "matchPackageNames": ["registry.redhat.io/ubi9/ubi-minimal-pqc"],
        "enabled": false
      }
    ],
    // Manager-level config for Dockerfile updates managed by MintMaker/Konflux
    "dockerfile": {
      "enabled": true,
      "schedule": ["at any time"],
      // Includes base branch in the branch name to avoid collisions across branches
      "additionalBranchPrefix": "{{baseBranch}}/",
      "branchPrefix": "konflux/mintmaker/",
      "ignoreTests": true,
      "automergeType": "pr",
      "automerge": true,
      "packageRules": [
        {
          // Disable all version-bump update types — only digest updates are wanted
          "matchUpdateTypes": [
            "major",
            "minor",
            "pin",
            "pinDigest",
            "patch",
            "bump"
          ],
          "enabled": false
        }
      ],
      // Only process Konflux/RHOAI Dockerfiles — ignorePaths does not support
      // negation patterns (!) so we use includePaths for positive selection instead.
      // Keep existing *Dockerfile.konflux* globs (covers <component>.Dockerfile.konflux)
      // and add Dockerfile*.konflux* for Dockerfile.<component>.konflux (e.g. feast).
      "includePaths": [
        "**/*Dockerfile.konflux*",
        "**/*Dockerfile.rhoai*",
        "**/*rhoai.Dockerfile*",
        "**/Dockerfile*.konflux*",
        "**/Dockerfile*.rhoai*"
      ],
      "pinDigests": true
    },
    "rpm": {
      "enabled": true,
      "schedule": ["at any time"]
    }
  }
