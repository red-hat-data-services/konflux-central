{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        // Refresh RPM lockfiles in the same PR as Dockerfile base-image updates.
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "branchPrefix": "renovate/",
    // Only target main branch + branches that are **past code freeze**. 
    //  If this targets a branch that is before code freeze, it will cause conflicts on main/release sync.
    "baseBranches": ["main", "rhoai-2.25", "rhoai-3.3", "rhoai-3.4", "rhoai-3.5", "rhoai-3.6"],
    "ignoreTests": true,
    "automergeType": "pr",
    "automerge": true,
    // No rate limit on PRs
    "prHourlyLimit": 0,
    "enabledManagers": ["dockerfile", "rpm", "rpm-lockfile", "custom.regex"],
    "customManagers": [
      {
        "customType": "regex",
        "description": [
          "Migrate and refresh UBI 9.8 references"
        ],
        "managerFilePatterns": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          // Select a FROM instruction or ARG assignment.
          "(?m)^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?[^\\r\\n]+|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[^\\r\\n]+)\\r?$",
          // Validate the complete registry/tag/digest token.
          "(?m)^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?registry\\.(?:access\\.redhat\\.com|redhat\\.io)/[a-z0-9/_-]+(?::(?:9\\.8|latest))?(?:@sha256:[a-f0-9]{64})?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?registry\\.(?:access\\.redhat\\.com|redhat\\.io)/[a-z0-9/_-]+(?::(?:9\\.8|latest)(?:@sha256:[a-f0-9]{64})?|@sha256:[a-f0-9]{64})[\"']?)(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // Keep extraction within supported image families, even under downstream enable rules.
          "(?m)^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?)(?:registry\\.access\\.redhat\\.com/(?:ubi9-minimal|ubi9/(?:ubi(?:-minimal)?|nodejs-22(?:-minimal)?|python-312(?:-minimal)?))|registry\\.redhat\\.io/(?:ubi9-minimal|ubi9/(?:ubi(?:-minimal(?:-pqc)?)?|python-312)))(?::(?:9\\.8|latest))?(?:@sha256:[a-f0-9]{64})?(?:[ \\t\"'\\r\\n]|$)",
          // Extract image fields; packageRules enforce the approved versions and branches.
          "(?<depName>registry\\.(?:access\\.redhat\\.com|redhat\\.io)/[a-z0-9/_-]+)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Migrate and refresh OpenJDK UBI 9.8 references"
        ],
        "managerFilePatterns": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          // Select a FROM instruction or ARG assignment.
          "(?m)^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?[^\\r\\n]+|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[^\\r\\n]+)\\r?$",
          // Validate the complete registry/tag/digest token.
          "(?m)^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?:registry\\.redhat\\.io/ubi9/openjdk-17)(?::(?:1\\.24-3\\.1793588566|latest))?(?:@sha256:[a-f0-9]{64})?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?:registry\\.redhat\\.io/ubi9/openjdk-17)(?::(?:1\\.24-3\\.1793588566|latest)(?:@sha256:[a-f0-9]{64})?|@sha256:[a-f0-9]{64})[\"']?)(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // Extract image fields; packageRules enforce the approved versions and branches.
          "(?<depName>(?:registry\\.redhat\\.io/ubi9/openjdk-17))(?::(?:(?<currentValue>1\\.24-3\\.1793588566)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0-3.1793588566{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Track literal base-image values in Konflux build-args"
        ],
        "managerFilePatterns": [
          "**/.konflux/build-args.conf"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          // Select a supported build-arg assignment.
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=[^\\r\\n]+\\r?$",
          // Validate the complete registry/tag/digest token.
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=registry\\.(?:access\\.redhat\\.com|redhat\\.io)/[a-z0-9/_-]+(?::(?:9\\.8|latest))?(?:@sha256:[a-f0-9]{64})?[ \\t]*\\r?$",
          // Keep extraction within supported image families, even under downstream enable rules.
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?:registry\\.access\\.redhat\\.com/(?:ubi9-minimal|ubi9/(?:ubi(?:-minimal)?|nodejs-22(?:-minimal)?|python-312(?:-minimal)?))|registry\\.redhat\\.io/(?:ubi9-minimal|ubi9/(?:ubi(?:-minimal(?:-pqc)?)?|python-312)))(?::(?:9\\.8|latest))?(?:@sha256:[a-f0-9]{64})?(?:[ \\t\"'\\r\\n]|$)",
          // Extract image fields; packageRules enforce the approved versions and branches.
          "(?<depName>registry\\.(?:access\\.redhat\\.com|redhat\\.io)/[a-z0-9/_-]+)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Track split PQC image/tag ARG defaults"
        ],
        "managerFilePatterns": [
          "**/Dockerfile.konflux"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          "(?:^|\\r?\\n)ARG[ \\t]+UBI_MINIMAL_BASE_IMAGE=registry\\.redhat\\.io/ubi9/ubi-minimal-pqc\\r?\\nARG[ \\t]+UBI_BASE_IMAGE_TAG=(?:9\\.8|latest)(?:@sha256:[a-f0-9]{64})?(?:\\r?\\n|$)",
          "ARG[ \\t]+UBI_BASE_IMAGE_TAG=(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "ARG UBI_BASE_IMAGE_TAG={{{newValue}}}@{{{newDigest}}}",
        "depNameTemplate": "registry.redhat.io/ubi9/ubi-minimal-pqc"
      },
      {
        "customType": "regex",
        "description": [
          "Track PQC digest ARG and FROM tag together"
        ],
        "managerFilePatterns": [
          "**/Dockerfile.konflux"
        ],
        "matchStringsStrategy": "any",
        "matchStrings": [
          "(?<before>(?:^|\\r?\\n)ARG[ \\t]+UBI9_MINIMAL_PQC_DIGEST=)(?<currentDigest>sha256:[a-f0-9]{64})(?<middle>\\r?\\n[\\s\\S]*?\\r?\\nFROM[ \\t]+registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)(?::(?<currentValue>9\\.8))?(?<after>@\\$\\{UBI9_MINIMAL_PQC_DIGEST\\})"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{replace 'ubi-minimal-pqc@' 'ubi-minimal-pqc:9.8@' (replace currentDigest newDigest replaceString)}}}",
        "depNameTemplate": "registry.redhat.io/ubi9/ubi-minimal-pqc"
      }
    ],
    "packageRules": [
      {
        // Auto-merge digest updates for Konflux Dockerfiles only
        "matchManagers": ["dockerfile"],
        "matchUpdateTypes": ["digest"],
        "matchFileNames": [
          // Existing patterns (keep): <component>.Dockerfile.konflux, Dockerfile.konflux, etc.
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          // Additional patterns: Dockerfile.<component>.konflux (e.g. feast)
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*"
        ],
        "enabled": true,
        "ignoreTests": true,
        "automergeType": "pr",
        "automerge": true,
        "groupName": "Dockerfile Digest Updates",
        "branchPrefix": "renovate/docker-main/",
        "semanticCommits": "enabled"
      },
      {
        "matchManagers": ["rpm"],
        "groupName": "RPM Updates",
        "commitMessageTopic": "RPM updates",
        "enabled": true,
        "schedule": ["at any time"],
        "branchPrefix": "renovate/rpm/",
        "semanticCommits": "enabled"
      },
      {
        // Enforce CI checks before automerge for AI Pipelines repos
        "matchRepositories": [
          "red-hat-data-services/data-science-pipelines",
          "red-hat-data-services/data-science-pipelines-operator",
          "red-hat-data-services/pipelines-components",
          "red-hat-data-services/argo-workflows"
        ],
        "ignoreTests": false,
        "platformAutomerge": false
      },
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi98"
        ],
        "description": [
          "Disable UBI 9.8 policy managers outside selected branches"
        ],
        "enabled": false
      },
      {
        "description": [
          "Avoid competing UBI updates on policy-managed files and branches"
        ],
        "matchBaseBranches": [
          "main",
          "rhoai-3.6",
          "rhoai-3.5"
        ],
        "matchManagers": [
          "dockerfile",
          "custom.regex"
        ],
        "matchPackageNames": [
          "registry.access.redhat.com/ubi9-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22",
          "registry.access.redhat.com/ubi9/python-312-minimal",
          "registry.access.redhat.com/ubi9/python-312",
          "registry.access.redhat.com/ubi9/ubi-minimal",
          "registry.access.redhat.com/ubi9/ubi",
          "registry.redhat.io/ubi9-minimal",
          "registry.redhat.io/ubi9/python-312",
          "registry.redhat.io/ubi9/ubi-minimal-pqc",
          "registry.redhat.io/ubi9/ubi-minimal",
          "registry.redhat.io/ubi9/ubi",
          "registry.redhat.io/ubi9/openjdk-17"
        ],
        "matchFileNames": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux",
          "**/.konflux/build-args.conf"
        ],
        "matchJsonata": [
          "$not($exists(currentValue)) or currentValue = null or currentValue = 'latest' or currentValue = '9.8' or currentValue = '1.24-3.1793588566'"
        ],
        "enabled": false
      },
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi98"
        ],
        "description": [
          "Migrate and track approved UBI images on the 9.8 stream"
        ],
        "matchBaseBranches": [
          "main",
          "rhoai-3.6",
          "rhoai-3.5"
        ],
        "matchPackageNames": [
          "registry.access.redhat.com/ubi9-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22",
          "registry.access.redhat.com/ubi9/python-312-minimal",
          "registry.access.redhat.com/ubi9/python-312",
          "registry.access.redhat.com/ubi9/ubi-minimal",
          "registry.access.redhat.com/ubi9/ubi",
          "registry.redhat.io/ubi9-minimal",
          "registry.redhat.io/ubi9/python-312",
          "registry.redhat.io/ubi9/ubi-minimal-pqc",
          "registry.redhat.io/ubi9/ubi-minimal",
          "registry.redhat.io/ubi9/ubi",
          "registry.redhat.io/ubi9/openjdk-17"
        ],
        "enabled": true,
        "allowedVersions": "/^9\\.8$/",
        "pinDigests": true,
        "automerge": false,
        "ignoreTests": false,
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "branchTopic": "ubi-9.8-{{depNameSanitized}}"
      },
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi98"
        ],
        "description": [
          "OpenJDK 17 has no literal 9.8 tag: use the verified UBI 9.8 build"
        ],
        "matchBaseBranches": [
          "main",
          "rhoai-3.6",
          "rhoai-3.5"
        ],
        "matchPackageNames": [
          "registry.redhat.io/ubi9/openjdk-17"
        ],
        "allowedVersions": "/^1\\.24-3\\.1793588566$/"
      }
    ],
    // Manager-level config for Dockerfile updates managed by MintMaker/Konflux
    "dockerfile": {
      "enabled": true,
      "schedule": ["at any time"],
      // Includes base branch in the branch name to avoid collisions across branches
      "additionalBranchPrefix": "{{baseBranch}}/",
      "branchPrefix": "konflux/mintmaker/",
      "ignoreTests": true,
      "automergeType": "pr",
      "automerge": true,
      "packageRules": [
        {
          // Disable all version-bump update types — only digest updates are wanted
          "matchUpdateTypes": [
            "major",
            "minor",
            "pin",
            "pinDigest",
            "patch",
            "bump"
          ],
          "enabled": false
        }
      ],
      // Only process Konflux/RHOAI Dockerfiles — ignorePaths does not support
      // negation patterns (!) so we use includePaths for positive selection instead.
      // Keep existing *Dockerfile.konflux* globs (covers <component>.Dockerfile.konflux)
      // and add Dockerfile*.konflux* for Dockerfile.<component>.konflux (e.g. feast).
      "includePaths": [
        "**/*Dockerfile.konflux*",
        "**/*Dockerfile.rhoai*",
        "**/*rhoai.Dockerfile*",
        "**/Dockerfile*.konflux*",
        "**/Dockerfile*.rhoai*"
      ],
      "pinDigests": true
    },
    "rpm": {
      "enabled": true,
      "schedule": ["at any time"]
    }
  }
