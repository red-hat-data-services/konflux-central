{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        // Refresh RPM lockfiles in the same PR as Dockerfile base-image updates.
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "branchPrefix": "renovate/",
    // Only target main branch + branches that are **past code freeze**. 
    //  If this targets a branch that is before code freeze, it will cause conflicts on main/release sync.
    "baseBranches": ["main", "rhoai-2.25", "rhoai-3.3", "rhoai-3.4", "rhoai-3.5", "rhoai-3.6"],
    "ignoreTests": true,
    "automergeType": "pr",
    "automerge": true,
    // No rate limit on PRs
    "prHourlyLimit": 0,
    "enabledManagers": ["dockerfile", "rpm", "rpm-lockfile", "custom.regex"],
    "customManagers": [
      // Steady-state argfile extraction; Dockerfile ARGs use the native manager.
      {
        "customType": "regex",
        "description": [
          "Refresh already-pinned UBI images in build-args.conf"
        ],
        "managerFilePatterns": [
          "**/.konflux/build-args.conf"
        ],

        "depTypeTemplate": "ubi-minor-pin-argfile",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",

        "matchStringsStrategy": "any",
        "autoReplaceStringTemplate": "{{{replace '^([^=]+=)[\\s\\S]*$' '$1' replaceString}}}{{{depName}}}:{{{newValue}}}@{{{newDigest}}}{{{replace '^[^=]+=[^\\s]+' '' replaceString}}}",
        "matchStrings": [
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/python-312):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$",
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi):(?<currentValue>9\\.8)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*\\r?$"
        ]
      }
    ],
    "packageRules": [
      {
        // Auto-merge digest updates for Konflux Dockerfiles only
        "matchManagers": ["dockerfile"],
        "matchUpdateTypes": ["digest"],
        "matchFileNames": [
          // Existing patterns (keep): <component>.Dockerfile.konflux, Dockerfile.konflux, etc.
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          // Additional patterns: Dockerfile.<component>.konflux (e.g. feast)
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*"
        ],
        "enabled": true,
        "ignoreTests": true,
        "automergeType": "pr",
        "automerge": true,
        "groupName": "Dockerfile Digest Updates",
        "branchPrefix": "renovate/docker-main/",
        "semanticCommits": "enabled"
      },
      {
        "matchManagers": ["rpm"],
        "groupName": "RPM Updates",
        "commitMessageTopic": "RPM updates",
        "enabled": true,
        "schedule": ["at any time"],
        "branchPrefix": "renovate/rpm/",
        "semanticCommits": "enabled"
      },
      {
        // Enforce CI checks before automerge for AI Pipelines repos
        "matchRepositories": [
          "red-hat-data-services/data-science-pipelines",
          "red-hat-data-services/data-science-pipelines-operator",
          "red-hat-data-services/pipelines-components",
          "red-hat-data-services/argo-workflows"
        ],
        "ignoreTests": false,
        "platformAutomerge": false
      },
      {
        "description": [
          "Keep already-pinned approved UBI images on the 9.8 stream"
        ],
        "matchManagers": [
          "dockerfile",
          "custom.regex"
        ],
        "matchBaseBranches": [
          "main",
          "rhoai-3.6",
          "rhoai-3.5"
        ],
        "matchPackageNames": [
          "registry.access.redhat.com/ubi9-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22",
          "registry.access.redhat.com/ubi9/python-312-minimal",
          "registry.access.redhat.com/ubi9/python-312",
          "registry.access.redhat.com/ubi9/ubi-minimal",
          "registry.access.redhat.com/ubi9/ubi",
          "registry.redhat.io/ubi9-minimal",
          "registry.redhat.io/ubi9/python-312",
          "registry.redhat.io/ubi9/ubi-minimal-pqc",
          "registry.redhat.io/ubi9/ubi-minimal",
          "registry.redhat.io/ubi9/ubi"
        ],
        "matchFileNames": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux",
          "**/.konflux/build-args.conf"
        ],
        "matchCurrentValue": "/^9\\.8$/",
        "allowedVersions": "/^9\\.8$/",
        "pinDigests": true,
        "automerge": false,
        "ignoreTests": false
      },
      {
        "description": [
          "Disable steady-state argfile extraction outside its explicit scope"
        ],
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi-minor-pin-argfile"
        ],
        "enabled": false
      },
      {
        "description": [
          "Enable steady-state argfile updates"
        ],
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi-minor-pin-argfile"
        ],
        "matchBaseBranches": [
          "main",
          "rhoai-3.6",
          "rhoai-3.5"
        ],
        "matchPackageNames": [
          "registry.access.redhat.com/ubi9-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22-minimal",
          "registry.access.redhat.com/ubi9/nodejs-22",
          "registry.access.redhat.com/ubi9/python-312-minimal",
          "registry.access.redhat.com/ubi9/python-312",
          "registry.access.redhat.com/ubi9/ubi-minimal",
          "registry.access.redhat.com/ubi9/ubi",
          "registry.redhat.io/ubi9-minimal",
          "registry.redhat.io/ubi9/python-312",
          "registry.redhat.io/ubi9/ubi-minimal-pqc",
          "registry.redhat.io/ubi9/ubi-minimal",
          "registry.redhat.io/ubi9/ubi"
        ],
        "matchFileNames": [
          "**/.konflux/build-args.conf"
        ],
        "matchCurrentValue": "/^9\\.8$/",
        "enabled": true,
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "branchTopic": "ubi-9.8-{{depNameSanitized}}"
      }
    ],
    // Manager-level config for Dockerfile updates managed by MintMaker/Konflux
    "dockerfile": {
      "enabled": true,
      "schedule": ["at any time"],
      // Includes base branch in the branch name to avoid collisions across branches
      "additionalBranchPrefix": "{{baseBranch}}/",
      "branchPrefix": "konflux/mintmaker/",
      "ignoreTests": true,
      "automergeType": "pr",
      "automerge": true,
      "packageRules": [
        {
          // Disable all version-bump update types — only digest updates are wanted
          "matchUpdateTypes": [
            "major",
            "minor",
            "pin",
            "pinDigest",
            "patch",
            "bump"
          ],
          "enabled": false
        }
      ],
      // Only process Konflux/RHOAI Dockerfiles — ignorePaths does not support
      // negation patterns (!) so we use includePaths for positive selection instead.
      // Keep existing *Dockerfile.konflux* globs (covers <component>.Dockerfile.konflux)
      // and add Dockerfile*.konflux* for Dockerfile.<component>.konflux (e.g. feast).
      // Native defaults miss names such as agent.Dockerfile.konflux.
      // Preserve the migration file scope, including its exact Containerfile exception.
      "managerFilePatterns": [
        "**/*Dockerfile.konflux*",
        "**/*Dockerfile.rhoai*",
        "**/*rhoai.Dockerfile*",
        "**/Dockerfile*.konflux*",
        "**/Dockerfile*.rhoai*",
        "**/Containerfile.server.konflux"
      ],
      "includePaths": [
        "**/*Dockerfile.konflux*",
        "**/*Dockerfile.rhoai*",
        "**/*rhoai.Dockerfile*",
        "**/Dockerfile*.konflux*",
        "**/Dockerfile*.rhoai*",
        "**/Containerfile.server.konflux"
      ],
      "pinDigests": true
    },
    "rpm": {
      "enabled": true,
      "schedule": ["at any time"]
    }
  }
