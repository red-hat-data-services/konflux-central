      },
      // Migration ownership: keep until downstream PRs are merged and coverage is verified.
      {
        "matchManagers": [
          "custom.regex"
        ],
        "matchDepTypes": [
          "ubi98"
        ],
        "description": [
          "Disable UBI 9.8 policy managers outside selected branches"
        ],
        "enabled": false
      },
      {
