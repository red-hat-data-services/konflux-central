{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        // Refresh RPM lockfiles in the same PR as Dockerfile base-image updates.
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "branchPrefix": "renovate/",
    // Only target main branch + branches that are **past code freeze**. 
    //  If this targets a branch that is before code freeze, it will cause conflicts on main/release sync.
    "baseBranches": ["main", "rhoai-2.25", "rhoai-3.3", "rhoai-3.4", "rhoai-3.5", "rhoai-3.6"],
    "ignoreTests": true,
    "automergeType": "pr",
    "automerge": true,
    // No rate limit on PRs
    "prHourlyLimit": 0,
    "enabledManagers": ["dockerfile", "rpm", "rpm-lockfile", "custom.regex"],
    "customManagers": [
      {
        "customType": "regex",
        "description": [
          "Migrate and refresh UBI 9.8 references"
        ],
        "managerFilePatterns": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux"
        ],
        // Each image has independent FROM, tagged-ARG, and digest-only-ARG patterns.
        "matchStringsStrategy": "any",
        "matchStrings": [
          // registry.access.redhat.com/ubi9-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/nodejs-22-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/nodejs-22
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/python-312-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/python-312
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/ubi-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.access.redhat.com/ubi9/ubi
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.redhat.io/ubi9-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.redhat.io/ubi9/python-312
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9/python-312)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/python-312):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/python-312)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.redhat.io/ubi9/ubi-minimal-pqc
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.redhat.io/ubi9/ubi-minimal
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          // registry.redhat.io/ubi9/ubi
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9/ubi)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi):(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/ubi)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        // Preserve the assignment/instruction prefix and any quotes, alias, or trailing text.
        "autoReplaceStringTemplate": "{{{replace '^([ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"\\x27]?))[\\s\\S]*$' '$1' replaceString}}}{{{depName}}}:{{{newValue}}}@{{{newDigest}}}{{{replace '^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"\\x27]?)[^\\s\"\\x27]+' '' replaceString}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Migrate and refresh OpenJDK UBI 9.8 references"
        ],
        "managerFilePatterns": [
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*",
          "**/Containerfile.server.konflux"
        ],
        // Independent patterns for the verified OpenJDK tag.
        "matchStringsStrategy": "any",
        "matchStrings": [
          // registry.redhat.io/ubi9/openjdk-17
          "(?m)^[ \\t]*[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?(?<depName>registry\\.redhat\\.io/ubi9/openjdk-17)(?::(?:(?<currentValue>1\\.24-3\\.1793588566)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/openjdk-17):(?:(?<currentValue>1\\.24-3\\.1793588566)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$",
          "(?m)^[ \\t]*ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"']?(?<depName>registry\\.redhat\\.io/ubi9/openjdk-17)@(?<currentDigest>sha256:[a-f0-9]{64})[\"']?(?:[ \\t]+[^\\r\\n]*)?\\r?$"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0-3.1793588566{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        // Preserve the assignment/instruction prefix and any quotes, alias, or trailing text.
        "autoReplaceStringTemplate": "{{{replace '^([ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"\\x27]?))[\\s\\S]*$' '$1' replaceString}}}{{{depName}}}:{{{newValue}}}@{{{newDigest}}}{{{replace '^[ \\t]*(?:[Ff][Rr][Oo][Mm][ \\t]+(?:--platform=[^\\s]+[ \\t]+)?|ARG[ \\t]+[A-Za-z_][A-Za-z0-9_]*=[\"\\x27]?)[^\\s\"\\x27]+' '' replaceString}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Track literal base-image values in Konflux build-args"
        ],
        "managerFilePatterns": [
          "**/.konflux/build-args.conf"
        ],
        // One independent assignment pattern per approved image.
        "matchStringsStrategy": "any",
        "matchStrings": [
          // registry.access.redhat.com/ubi9-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/nodejs-22-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/nodejs-22
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/nodejs-22)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/python-312-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/python-312
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/python-312)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/ubi-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.access.redhat.com/ubi9/ubi
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.access\\.redhat\\.com/ubi9/ubi)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.redhat.io/ubi9-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.redhat.io/ubi9/python-312
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/python-312)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.redhat.io/ubi9/ubi-minimal-pqc
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.redhat.io/ubi9/ubi-minimal
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi-minimal)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$",
          // registry.redhat.io/ubi9/ubi
          "(?m)^[ \\t]*(?:BASE_IMAGE|RELEASE_BASE_IMAGE)=(?<depName>registry\\.redhat\\.io/ubi9/ubi)(?::(?:(?<currentValue>9\\.8)|latest))?(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[ \\t]*\\r?$"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        // Preserve the assignment/instruction prefix and any quotes, alias, or trailing text.
        "autoReplaceStringTemplate": "{{{replace '^([^=]+=)[\\s\\S]*$' '$1' replaceString}}}{{{depName}}}:{{{newValue}}}@{{{newDigest}}}{{{replace '^[^=]+=[^\\s]+' '' replaceString}}}"
      },
      {
        "customType": "regex",
        "description": [
          "Track split PQC image/tag ARG defaults"
        ],
        "managerFilePatterns": [
          "**/Dockerfile.konflux"
        ],
        "matchStringsStrategy": "recursive",
        "matchStrings": [
          "(?:^|\\r?\\n)ARG[ \\t]+UBI_MINIMAL_BASE_IMAGE=registry\\.redhat\\.io/ubi9/ubi-minimal-pqc\\r?\\nARG[ \\t]+UBI_BASE_IMAGE_TAG=(?:9\\.8|latest)(?:@sha256:[a-f0-9]{64})?(?:\\r?\\n|$)",
          "ARG[ \\t]+UBI_BASE_IMAGE_TAG=(?:(?<currentValue>9\\.8)|latest)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "ARG UBI_BASE_IMAGE_TAG={{{newValue}}}@{{{newDigest}}}",
        "depNameTemplate": "registry.redhat.io/ubi9/ubi-minimal-pqc"
      },
      {
        "customType": "regex",
        "description": [
          "Track PQC digest ARG and FROM tag together"
        ],
        "managerFilePatterns": [
          "**/Dockerfile.konflux"
        ],
        "matchStringsStrategy": "any",
        "matchStrings": [
          "(?<before>(?:^|\\r?\\n)ARG[ \\t]+UBI9_MINIMAL_PQC_DIGEST=)(?<currentDigest>sha256:[a-f0-9]{64})(?<middle>\\r?\\n[\\s\\S]*?\\r?\\nFROM[ \\t]+registry\\.redhat\\.io/ubi9/ubi-minimal-pqc)(?::(?<currentValue>9\\.8))?(?<after>@\\$\\{UBI9_MINIMAL_PQC_DIGEST\\})"
        ],
        "depTypeTemplate": "ubi98",
        "currentValueTemplate": "{{#if currentValue}}{{{currentValue}}}{{else}}0.0{{/if}}",
        "datasourceTemplate": "docker",
        "versioningTemplate": "docker",
        "autoReplaceStringTemplate": "{{{replace 'ubi-minimal-pqc@' 'ubi-minimal-pqc:9.8@' (replace currentDigest newDigest replaceString)}}}",
        "depNameTemplate": "registry.redhat.io/ubi9/ubi-minimal-pqc"
      }
    ],
    "packageRules": [
      {
        // Auto-merge digest updates for Konflux Dockerfiles only
        "matchManagers": ["dockerfile"],
        "matchUpdateTypes": ["digest"],
        "matchFileNames": [
          // Existing patterns (keep): <component>.Dockerfile.konflux, Dockerfile.konflux, etc.
          "**/*Dockerfile.konflux*",
          "**/*Dockerfile.rhoai*",
          "**/*rhoai.Dockerfile*",
          // Additional patterns: Dockerfile.<component>.konflux (e.g. feast)
          "**/Dockerfile*.konflux*",
          "**/Dockerfile*.rhoai*"
        ],
        "enabled": true,
        "ignoreTests": true,
        "automergeType": "pr",
        "automerge": true,
        "groupName": "Dockerfile Digest Updates",
        "branchPrefix": "renovate/docker-main/",
        "semanticCommits": "enabled"
      },
      {
        "matchManagers": ["rpm"],
        "groupName": "RPM Updates",
        "commitMessageTopic": "RPM updates",
        "enabled": true,
        "schedule": ["at any time"],
        "branchPrefix": "renovate/rpm/",
        "semanticCommits": "enabled"
      },
      {
        // Enforce CI checks before automerge for AI Pipelines repos
