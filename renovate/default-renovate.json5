        "branchTopic": "ubi-9.8-{{depNameSanitized}}"
      }
    ],
    // Manager-level config for Dockerfile updates managed by MintMaker/Konflux
    "dockerfile": {
      "enabled": true,
      "schedule": ["at any time"],
      // Includes base branch in the branch name to avoid collisions across branches
      "additionalBranchPrefix": "{{baseBranch}}/",
      "branchPrefix": "konflux/mintmaker/",
      "ignoreTests": true,
      "automergeType": "pr",
      "automerge": true,
      "packageRules": [
        {
          // Disable all version-bump update types — only digest updates are wanted
          "matchUpdateTypes": [
            "major",
            "minor",
            "pin",
            "pinDigest",
            "patch",
            "bump"
          ],
          "enabled": false
        }
      ],
      // Only process Konflux/RHOAI Dockerfiles — ignorePaths does not support
      // negation patterns (!) so we use includePaths for positive selection instead.
      // Keep existing *Dockerfile.konflux* globs (covers <component>.Dockerfile.konflux)
      // and add Dockerfile*.konflux* for Dockerfile.<component>.konflux (e.g. feast).
      "includePaths": [
        "**/*Dockerfile.konflux*",
        "**/*Dockerfile.rhoai*",
        "**/*rhoai.Dockerfile*",
        "**/Dockerfile*.konflux*",
        "**/Dockerfile*.rhoai*"
      ],
      "pinDigests": true
    },
    "rpm": {
      "enabled": true,
      "schedule": ["at any time"]
    }
