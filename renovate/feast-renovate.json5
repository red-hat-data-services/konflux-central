{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>red-hat-data-services/konflux-central//renovate/default-renovate.json5",
    "github>opendatahub-io/renovate-config//base-images"
  ],
  "enabledManagers": [
    "dockerfile",
    "rpm",
    "rpm-lockfile",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Feast feature-server AIPCC base image tags and digests",
      "managerFilePatterns": [
        "Dockerfiles/Dockerfile.feature-server.konflux"
      ],
      "matchStrings": [
        "ARG\\s+BASE_IMAGE=[\"']?(?<depName>quay\\.io/aipcc/base-images/[^:@\\s\"']+):(?<currentValue>[^@\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?:base-v)?(?<major>\\d+)(?:\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-ea\\.(?<prerelease>\\d+))?)?$"
    }
  ],
  "packageRules": [
    {
      "description": "Let the Feast regex manager own the feature-server base image",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfiles/Dockerfile.feature-server.konflux"],
      "enabled": false
    }
  ]
}
