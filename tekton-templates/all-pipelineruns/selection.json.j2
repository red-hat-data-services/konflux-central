{# Selection owns eligibility only; resource values remain in default.yaml.j2. #}
{%- set scan = 'rpms-signature-scan' -%}
{%- set single = 'pipelines/container-build.yaml' -%}
{%- set multi = 'pipelines/multi-arch-container-build.yaml' -%}
{%- set families = ['pipelines/helm-chart-build.yaml', 'pipelines/fbc-fragment-build.yaml'] -%}
{%- set ns = namespace(status='applicable', reason='', pipeline=spec.get('pipelineSpec'), family=false) -%}
{%- if ns.pipeline is none -%}
  {%- set ref = spec.get('pipelineRef', {}) -%}
  {%- if ref.get('resolver') != 'git' or pipelineref.get('url') != 'https://github.com/red-hat-data-services/konflux-central.git' or pipelineref.get('pathInRepo') not in [single, multi] + families -%}
    {%- set ns.status = 'unresolved' -%}
    {%- set ns.reason = 'Pipeline reference requires explicit resolution' -%}
  {%- elif pipelineref.get('pathInRepo') in families -%}
    {%- set ns.family = true -%}
    {%- set definition = context.documents.get(pipelineref.get('pathInRepo')) -%}
    {%- if pipelineref.get('revision') not in [branch, '{{ target_branch }}', '{{target_branch}}'] -%}
      {%- set ns.status = 'unresolved' -%}
      {%- set ns.reason = 'Pipeline reference requires explicit resolution' -%}
    {%- elif definition is none -%}
      {%- set ns.status = 'unresolved' -%}
      {%- set ns.reason = 'Branch-local Pipeline source is missing' -%}
    {%- elif definition is not mapping or definition.get('kind') != 'Pipeline' or definition.get('spec') is not mapping -%}
      {{- fail('invalid branch-local Pipeline source') -}}
    {%- elif 'pull-request' in metadata.get('name', '') or 'pull_request' in annotations.get('pipelinesascode.tekton.dev/on-event', '') or ('-on-schedule' not in metadata.get('name', '') and 'event == "push"' not in annotations.get('pipelinesascode.tekton.dev/on-cel-expression', '')) -%}
      {%- set ns.status = 'skipped' -%}
      {%- set ns.reason = 'Family policy applies only to push and scheduled runs' -%}
    {%- elif not (definition.spec.get('workspaces', []) | unique_item('name', 'git-auth')) -%}
      {{- fail('family Pipeline must declare git-auth workspace') -}}
    {%- endif -%}
  {%- elif pipelineref.get('pathInRepo') != multi -%}
    {%- if pipelineref.get('revision') not in [branch, '{{ target_branch }}', '{{target_branch}}'] -%}
      {%- set ns.status = 'unresolved' -%}
      {%- set ns.reason = 'Pipeline reference requires explicit resolution' -%}
    {%- else -%}
      {%- set definition = context.documents.get(single) -%}
      {%- if definition is none -%}
        {%- set ns.status = 'unresolved' -%}
        {%- set ns.reason = 'Branch-local Pipeline source is missing' -%}
      {%- elif definition is not mapping or definition.get('kind') != 'Pipeline' or definition.get('spec') is not mapping -%}
        {{- fail('invalid branch-local Pipeline source') -}}
      {%- else -%}
        {%- set ns.pipeline = definition.spec -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if ns.status == 'applicable' and not ns.family and ns.pipeline is not none -%}
  {%- if ns.pipeline is not mapping -%}{{ fail('invalid inline Pipeline source') }}{%- endif -%}
  {%- set task = (ns.pipeline.get('tasks', []) + ns.pipeline.get('finally', [])) | unique_item('name', scan) -%}
  {%- if not task -%}
    {%- set ns.status = 'skipped' -%}
    {%- set ns.reason = 'Pipeline does not contain the scan task' -%}
  {%- endif -%}
{%- endif -%}
{%- if ns.status == 'applicable' and not ns.family -%}
  {%- set override = spec.get('taskRunSpecs', []) | unique_item('pipelineTaskName', scan) -%}
  {%- set step = override.get('stepSpecs', []) | unique_item('name', scan) -%}
{%- endif -%}
{{- {'status': ns.status, 'reason': ns.reason} | tojson -}}
