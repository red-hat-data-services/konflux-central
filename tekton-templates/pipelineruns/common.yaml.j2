# Only declared fields are owned by this template. Preserve everything else.
spec:
  workspaces:
  - name: git-auth
    secret:
      secretName: "{{ '{{ git_auth_secret }}' }}"
  taskRunSpecs:
    - pipelineTaskName: rpms-signature-scan
      computeResources: "{{ ABSENT }}"
      stepSpecs:
        - name: rpms-signature-scan
          computeResources:
            requests:
              cpu: "500m"
              memory: "1Gi"
            limits:
              cpu: "500m"
              memory: "1Gi"
